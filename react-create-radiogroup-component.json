={value}\n        type=\"radio\"\n        name={value}\n        value={value}\n        checked={checked}\n        onChange={(e) => {\n          onChange(e.target.value);\n        }}\n      />\n      <label htmlFor={value}>{children}</label>\n    </div>\n  );\n};\n","position":{"start":{"line":99,"column":1},"end":{"line":136,"column":1}},"key":"IUgRAa4C01"}],"key":"Uvzw3QyGQl"}],"key":"EF5whR2gTx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Create a Custom Hook, usePrevious, in React","url":"/react-custom-hook-use-previous","group":"React Guides"},"next":{"title":"City Explorer Android App","url":"/city-explorer-app","group":"Android Development"}}},"domain":"http://localhost:3000"}