heme} from \"./ThemeContext\";\nimport Switch from \"./Switch\";\nimport {memo} from \"react\";\n\nconst Title = ({children}) => {\n    const {theme, toggleTheme} = useTheme();\n    return (\n        <h2\n            style={{\n                color: theme === \"light\" ? \"black\" : \"white\",\n            }}\n        >\n            {children}\n        </h2>\n    );\n};\n\nconst Paragraph = ({children}) => {\n    const {theme, toggleTheme} = useTheme();\n    return (\n        <p\n            style={{\n                color: theme === \"light\" ? \"black\" : \"white\",\n            }}\n        >\n            {children}\n        </p>\n    );\n};\n\nconst Content = () => {\n    return (\n        <div>\n            <Paragraph>\n                We are a pizza loving family. And for years, I searched and searched and\n                searched for the perfect pizza dough recipe. I tried dozens, or more.\n                And while some were good, none of them were that recipe that would make\n                me stop trying all of the others.\n            </Paragraph>\n        </div>\n    );\n};\n\nconst Header = () => {\n    return (\n        <header>\n            <Title>Little Lemon</Title>\n            <Switch/>\n        </header>\n    );\n};\n\nconst Page = () => {\n    return (\n        <div className=\"Page\">\n            <Title>When it comes to dough</Title>\n            <Content/>\n        </div>\n    );\n};\n\n// using memoization: https://react.dev/reference/react/useMemo#skipping-re-rendering-of-components\nconst App = memo(() => {\n    const {theme, toggleTheme} = useTheme();\n    return (\n        <div\n            className=\"App\"\n            style={{\n                backgroundColor: theme === \"light\" ? \"white\" : \"black\",\n            }}\n        >\n            <Header/>\n            <Page/>\n        </div>\n    );\n});\n\nfunction Root() {\n    return (\n        <ThemeProvider>\n            <App/>\n        </ThemeProvider>\n    );\n}\n\nexport default Root;","position":{"start":{"line":49,"column":1},"end":{"line":137,"column":1}},"key":"XKN6dQs2g6"},{"type":"heading","depth":3,"position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"ThemeContext.js","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"RmXtQEprq9"}],"identifier":"themecontext-js","label":"ThemeContext.js","html_id":"themecontext-js","implicit":true,"key":"kHx3zChpuK"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"q2J1rA6J8C"}],"key":"Zw0HaNWFs7"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"The ThemeContext.js file contains the context provider and the context.","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"SFNIWkOrwS"}],"key":"C7AQuE1eXQ"},{"type":"paragraph","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"The context is defined using the ","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"swO0ZNtaZj"},{"type":"inlineCode","value":"createContext","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"MN1PTo3IXQ"},{"type":"text","value":" method.","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"daZvyMsFGJ"}],"key":"X2FoLLNoAp"},{"type":"code","lang":"jsx","value":"const ThemeContext = createContext(undefined);","position":{"start":{"line":146,"column":1},"end":{"line":148,"column":1}},"key":"hW25JP74pN"},{"type":"paragraph","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"The context provider is defined as a component with the ‘{children}’ prop.","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"YgfpMuJxeL"}],"key":"TiGdscE