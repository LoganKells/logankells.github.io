me === \"light\" ? \"white\" : \"black\",\n            }}\n        >\n            <Header/>\n            <Page/>\n        </div>\n    );\n});\n\nfunction Root() {\n    return (\n        <ThemeProvider>\n            <App/>\n        </ThemeProvider>\n    );\n}\n\nexport default Root;","position":{"start":{"line":46,"column":1},"end":{"line":134,"column":1}},"key":"g1H6iQkPTI"},{"type":"heading","depth":3,"position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"ThemeContext.js","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"xcc2z0wlgm"}],"identifier":"themecontext-js","label":"ThemeContext.js","html_id":"themecontext-js","implicit":true,"key":"KpoeIPxbra"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"MrEjIK9PDN"}],"key":"Bf1HRUE2Rj"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"The ThemeContext.js file contains the context provider and the context.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"qUphz7TefZ"}],"key":"TazGcSj7ve"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"The context is defined using the ","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"qV8awXzSD8"},{"type":"inlineCode","value":"createContext","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"nIYkPLcI0s"},{"type":"text","value":" method.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"IIk3msk8IX"}],"key":"W9BfJCeR6e"},{"type":"code","lang":"jsx","value":"const ThemeContext = createContext(undefined);","position":{"start":{"line":143,"column":1},"end":{"line":145,"column":1}},"key":"aomQnsw7cY"},{"type":"paragraph","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"The context provider is defined as a component with the ‘{children}’ prop.","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"Yb4x6Vq2P3"}],"key":"jkUE8PPWTe"},{"type":"code","lang":"jsx","value":"const ThemeProvider = ({children}) => {\n}","position":{"start":{"line":149,"column":1},"end":{"line":152,"column":1}},"key":"OzqF7jI5Yw"}],"key":"DbIHG1kHTH"},{"type":"heading","depth":4,"children":[{"type":"strong","children":[{"type":"inlineCode","value":"ThemeContext.js","key":"dFv5ahValb"}],"key":"bns3KouzpB"}],"identifier":"themecontext-js","label":"ThemeContext.js","html_id":"themecontext-js-1","implicit":true,"key":"BFZF0a6qte"},{"type":"code","lang":"jsx","value":"import {createContext, useContext, useState} from \"react\";\n\nconst ThemeContext = createContext(undefined);\n\nconst ThemeProvider = ({children}) => {\n    // Give the child component a `theme` state\n    const [theme, setTheme] = useState(\"light\");\n\n    // Return a `ThemeContext.Provider` component that receives an object\n    // as its value prop, with a `theme` string and a `toggleTheme` function\n    return (\n        // https://react.dev/reference/react/createContext#provider\n        // Wrap your components into a context provider to specify\n        // the value of this context for all components inside:\n        <ThemeContext.Provider\n            value={{\n                theme: theme,\n                toggleTheme: () => setTheme(theme === \"light\" ? \"dark\" : \"light\"),\n            }}\n        >\n            {children}\n        </ThemeContext.Provider>\n    );\n};\n\n// Change `useTheme` so that it returns `useContext(ThemeContext);`\n// instead of the `{theme: \"light\"}` object\nconst useTheme = () => useContext(ThemeContext);\n\n// export const ThemeProvider = ({ children }) => children;\n// export const useTheme = () => ({ theme: \"light\" });\nexport {ThemePro