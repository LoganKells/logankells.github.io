sx","value":"import { useEffect, useRef } from \"react\";\n\n/**\n * usePrevious is a custom hook. \n * */\nfunction usePrevious(val) {\n  const prevVal = useRef(\"\");\n  useEffect(() => {\n    console.log(\"next previous value:\", val);\n    prevVal.current = val;\n  }, [val]);\n  return prevVal.current;\n}\n\nexport { usePrevious };","position":{"start":{"line":32,"column":1},"end":{"line":48,"column":1}},"key":"oIJUI7ZBiN"},{"type":"heading","depth":3,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"App.js","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"yjPbAPrDd0"}],"identifier":"app-js","label":"App.js","html_id":"app-js","implicit":true,"key":"Ii0Mmazwtw"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"The application component that uses the ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"cBGDDMXnGu"},{"type":"inlineCode","value":"usePrevious","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"JTYQ8QKpma"},{"type":"text","value":" custom hook to display\nthe ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"c6MAjTTFQy"},{"type":"inlineCode","value":"prevDay","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Rm7PAzxhc0"},{"type":"text","value":" of the week offset\nfrom the active ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"sCpmcHso5N"},{"type":"inlineCode","value":"day","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"p0AEbIsEEK"},{"type":"text","value":".","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Dj7TQ4cjyx"}],"key":"kUAovxNYFv"},{"type":"heading","depth":4,"children":[{"type":"strong","children":[{"type":"inlineCode","value":"App.js","key":"BUjafvn0Cr"}],"key":"dF4vX99CJD"}],"identifier":"app-js","label":"App.js","html_id":"app-js-1","implicit":true,"key":"QXjMyDmblE"},{"type":"code","lang":"jsx","value":"import { useState, useEffect, useRef } from \"react\";\nimport { usePrevious } from \"./usePrevious\";\n\nexport default function App() {\n  const [day, setDay] = useState(\"Monday\");\n  const prevDay = usePrevious(day);\n  const getNextDay = () => {\n    if (day === \"Monday\") {\n      setDay(\"Tuesday\");\n    } else if (day === \"Tuesday\") {\n      setDay(\"Wednesday\");\n    } else if (day === \"Wednesday\") {\n      setDay(\"Thursday\");\n    } else if (day === \"Thursday\") {\n      setDay(\"Friday\");\n    } else if (day === \"Friday\") {\n      setDay(\"Monday\");\n    }\n  };\n  return (\n    <div style={{ padding: \"40px\" }}>\n      <h1>\n        Today is: {day}\n        <br />\n        {prevDay && <span>Previous work day was: {prevDay}</span>}\n      </h1>\n      <button onClick={getNextDay}>Get next day</button>\n    </div>\n  );\n}","position":{"start":{"line":58,"column":1},"end":{"line":89,"column":1}},"key":"JiLxlHPnh6"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"References","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"uRkodIEdIW"}],"identifier":"references","label":"References","html_id":"references","implicit":true,"key":"PrkUd3Q5Gx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":93,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://react.dev/learn/reusing-logic-with-custom-hooks","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Reusing Logic with Custom Hooks | React Docs","position":{"start":{"line":9